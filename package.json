{
  "name": "owlmatch",
  "version": "1.0.0",
  "exports": {
    ".": "./server/index.ts",
    "./web": "./src/main.tsx",
    "./shared/calendar": "./shared/calendar.ts",
    "./shared/eventPlace": "./shared/eventPlace.ts",
    "./shared/eventValidation": "./shared/eventValidation.ts",
    "./shared/interests": "./shared/interests.ts",
    "./shared/ranking": "./shared/ranking.ts",
    "./shared/schemas": "./shared/schemas.ts",
    "./shared/text": "./shared/text.ts",
    "./shared/time": "./shared/time.ts",
    "./shared/types": "./shared/types.ts",
    "./scripts/import-owl-life": "./scripts/import-owl-life.ts",
    "./scripts/reset-demo": "./scripts/reset-demo.ts"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "demo:reset": "tsx scripts/reset-demo.ts",
    "import:owl-life": "tsx scripts/import-owl-life.ts"
  },
  "license": "MIT",
  "description": "AI-powered campus discovery and social connection for KSU students (student-built hackathon project).",
  "dependencies": {
    "@tanstack/react-query": "^5.108.1",
    "express": "^4.22.3",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "pdfjs-dist": "^4.10.38",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
