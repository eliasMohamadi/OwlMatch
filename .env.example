# Server-side only. Never prefix with VITE_ (that would ship it to the browser).
GEMINI_API_KEY=
# Optional overrides
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=25000
PORT=8787
# OWLMATCH_DATA_DIR=./server/data

# --- Sign-in (see docs/AUTH.md) ---
# The URL students open. Microsoft redirects to <APP_BASE_URL>/api/auth/microsoft/callback.
APP_BASE_URL=http://localhost:5173
# Signs session cookies. Required in production (32+ characters).
SESSION_SECRET=
# Microsoft Entra app registration for the university tenant (the tenant id must be the GUID).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Comma-separated, exact domain match.
ALLOWED_EMAIL_DOMAINS=students.kennesaw.edu,kennesaw.edu
# Enables admin sign-in to test as demo students. Leave empty to disable.
ADMIN_PASSWORD=
# Production only: allow the admin data reset.
# OWLMATCH_ALLOW_RESET=1
